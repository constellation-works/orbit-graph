#!/bin/sh
set -eu

# Select the executable: a binary bundled beside this launcher
# (scripts/bundle-plugin-binary.sh places it), else the first orbit-graph on
# the caller's PATH. Orbit runs plugin backends with a cleared environment, so
# no override variable could reach this script.
#
# What may run is bound by the manifest's `spec.backend.args`, which the
# manifest digest Orbit records at consent covers (STD-05 R21):
#   --backend-sha256 <hex>   run only an executable with this SHA-256;
#   --allow-unbound-backend  the named override: run a compatible executable
#                            whatever its digest, with a stderr notice and
#                            `backend_override` on every response (STD-05 R4).
# The version probe below also keeps a stale executable from being used.
launcher_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
bundled_binary="$launcher_dir/orbit-graph.bin"
if [ -e "$bundled_binary" ]; then
    graph_binary=$bundled_binary
else
    graph_binary=$(command -v orbit-graph 2>/dev/null || true)
fi

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

incompatible() {
    path=$(json_escape "$graph_binary")
    printf '{"ok":false,"error":{"code":"incompatible_binary","message":"orbit-graph at %s must support the v2 envelope (plugin_schema_version=1, extractor_version=22)","path":"%s"}}\n' "$path" "$path"
    exit 0
}

# Refuse an executable that the consented manifest does not bind; `$1` says why.
unbound() {
    path=$(json_escape "$graph_binary")
    reason=$(json_escape "$1")
    printf '{"ok":false,"error":{"code":"incompatible_binary","message":"orbit-graph at %s is not the executable this plugin was approved to run: %s","path":"%s","detail":{"path":"%s","expected_sha256":"%s","actual_sha256":"%s"}}}\n' \
        "$path" "$reason" "$path" "$path" "$expected_sha256" "${actual_sha256:-}"
    exit 0
}

expected_sha256=""
allow_unbound=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --backend-sha256)
            [ "$#" -ge 2 ] || unbound "--backend-sha256 needs a value in spec.backend.args"
            expected_sha256=$2
            shift 2
            ;;
        --allow-unbound-backend) allow_unbound=1; shift ;;
        *) unbound "unknown launcher argument in spec.backend.args: $1" ;;
    esac
done
case "$expected_sha256" in
    '') ;;
    *[!0-9a-f]*) unbound "--backend-sha256 must be 64 lowercase hex digits" ;;
    *) [ "${#expected_sha256}" -eq 64 ] || unbound "--backend-sha256 must be 64 lowercase hex digits" ;;
esac
if [ -n "$expected_sha256" ] && [ "$allow_unbound" -eq 1 ]; then
    unbound "spec.backend.args names both --backend-sha256 and --allow-unbound-backend"
fi
if [ -z "$expected_sha256" ] && [ "$allow_unbound" -eq 0 ]; then
    unbound "spec.backend.args records no --backend-sha256 (run scripts/bundle-plugin-binary.sh) and no --allow-unbound-backend override"
fi

[ -n "$graph_binary" ] || incompatible
[ -x "$graph_binary" ] || incompatible
[ "${ORBIT_GRAPH_LAUNCHER_PROBING:-}" != 1 ] || incompatible

# The digest is checked before the executable runs at all, the probe included.
if [ -n "$expected_sha256" ]; then
    if command -v sha256sum >/dev/null 2>&1; then
        actual_sha256=$(sha256sum < "$graph_binary" | cut -d ' ' -f 1)
    elif command -v shasum >/dev/null 2>&1; then
        actual_sha256=$(shasum -a 256 < "$graph_binary" | cut -d ' ' -f 1)
    else
        unbound "neither sha256sum nor shasum is available to verify it"
    fi
    [ "$actual_sha256" = "$expected_sha256" ] || unbound "its SHA-256 does not match --backend-sha256"
fi

# Use a separate stdin stream so the caller's request is untouched. Probe the
# actual envelope contract, including the versions expected by this release.
probe=$(printf '%s\n' '{"tool":"orbit.graph.version","input":{}}' |
    ORBIT_GRAPH_LAUNCHER_PROBING=1 ORBIT_TOOL_NAME=orbit.graph.version "$graph_binary" 2>/dev/null) || incompatible
case "$probe" in
    *'"ok":true'*) ;;
    *) incompatible ;;
esac
case "$probe" in
    *'"extractor_version":22'*) ;;
    *) incompatible ;;
esac
case "$probe" in
    *'"plugin_schema_version":1'*) ;;
    *) incompatible ;;
esac

if [ -z "$expected_sha256" ]; then
    echo "orbit-graph launcher: backend override: running $graph_binary unverified (spec.backend.args has --allow-unbound-backend and records no --backend-sha256)" >&2
    ORBIT_GRAPH_BACKEND_OVERRIDE=$graph_binary
    export ORBIT_GRAPH_BACKEND_OVERRIDE
else
    unset ORBIT_GRAPH_BACKEND_OVERRIDE
fi
exec "$graph_binary"
