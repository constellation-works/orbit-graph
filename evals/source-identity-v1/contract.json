{
  "contract": "source-identity-v1",
  "schema_version": 1,
  "adoption": "prospective_explicit_only",
  "identity": [
    "language",
    "file",
    "line",
    "column",
    "kind",
    "module",
    "owner",
    "trait",
    "leaf"
  ],
  "rust_dot_spelling": "rejected_use_double_colon",
